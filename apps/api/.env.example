APP_NAME="Ragnest API"
LOG_LEVEL=INFO
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SECRET_KEY=change-me
GEMINI_API=your-gemini-api-key
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated browser origins allowed to call the API (CORS). Leave empty to
# keep CORS disabled: the web app proxies server-side, so it needs no entry.
CORS_ORIGINS=

# Google sign-in. All three are required to turn it on; leave them empty and the
# button stays hidden and POST /api/v1/auth/google answers 503. The redirect URI
# is the WEB app's callback (not this API), and must be byte-identical to the
# value in the web app's env and in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Local convenience only. The app never reads these: point DATABASE_URL at the
# production branch when running migrations against it (use the direct URL), and
# set DATABASE_URL on the API host to the pooled URL.
DATABASE_URL_PROD=
DATABASE_URL_PROD_DIRECT=
