# Where the FastAPI backend runs. Read only by server code (route handlers).
API_URL=http://127.0.0.1:8000

# Google sign-in. Server-only: read inside route handlers and server
# components, never sent to the browser. GOOGLE_REDIRECT_URI is this app's
# callback and must be byte-identical to the value in the API's env and in the
# Google Cloud console. Leave both empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
